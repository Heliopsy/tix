# Toolbox image holding every linter and scanner at the versions CI uses.
# Built once and cached; `just ci` runs every gate inside it so local and CI
# results cannot diverge.
ARG GO_VERSION=1.27.3
FROM docker.io/library/golang:${GO_VERSION}-alpine

# Tool versions are pinned here and nowhere else.
ARG GOLANGCI_LINT_VERSION=v2.15.0
ARG GOSEC_VERSION=v2.30.0
ARG GOVULNCHECK_VERSION=v1.9.0
ARG ACTIONLINT_VERSION=v1.7.12
ARG GORELEASER_VERSION=v2.20.0
ARG TRIVY_VERSION=v0.76.1
# The two tools fetched as release assets rather than built from a checksummed
# module are checked against these, here and in .github/actions/toolbox. A
# version bump changes its sha256 in the same commit.
ARG TRIVY_SHA256=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0
ARG GITLEAKS_VERSION=v8.30.1
ARG HADOLINT_VERSION=v2.15.1
ARG HADOLINT_SHA256=c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507
# 1.14.1 made requirement text over 500 characters a warning, and --strict
# fails on warnings, so requirements are split rather than compressed. 1.16.0
# needs node 22.12 or newer for an npm install.
ARG OPENSPEC_VERSION=1.16.0
ARG MARKDOWNLINT_VERSION=0.50.0
ARG YAMLLINT_VERSION=1.38.0

# DL3018: alpine package versions move with the base image, so pinning them
# here breaks every base bump. The base tag plus the pinned tool versions below
# are what this image's reproducibility rests on.
# hadolint ignore=DL3018
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

# nodejs also backs `just jstest`, which runs internal/web/jstest with node's
# own built-in test runner. That suite pulls in no npm package, so there is no
# JavaScript build step and no developer-side dependency: node only has to
# exist here.
# shellcheck is here for two gates now. actionlint shells out to it when
# present and silently skips that integration when it is not, which made the
# containerised gate quietly weaker than the same command run from PATH. It is
# also `just shellcheck` in its own right, over the demo scene's scripts.
# hadolint ignore=DL3018
RUN apk add --no-cache git bash curl tar nodejs npm py3-pip ca-certificates shellcheck

RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
 && go install github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION} \
 && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
 && go install github.com/rhysd/actionlint/cmd/actionlint@${ACTIONLINT_VERSION} \
 && go install github.com/goreleaser/goreleaser/v2@${GORELEASER_VERSION} \
 && go install github.com/zricethezav/gitleaks/v8@${GITLEAKS_VERSION}

# Fetch the release tarball directly. The upstream install.sh needs capabilities
# that are not available in a rootless build.
RUN TRIVY_NUM=$(echo "${TRIVY_VERSION}" | sed 's/^v//') \
 && curl -sfL -o /tmp/trivy.tar.gz \
      "https://github.com/aquasecurity/trivy/releases/download/${TRIVY_VERSION}/trivy_${TRIVY_NUM}_Linux-64bit.tar.gz" \
 && echo "${TRIVY_SHA256}  /tmp/trivy.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
 && rm -f /tmp/trivy.tar.gz \
 && trivy --version

RUN curl -sfL -o /usr/local/bin/hadolint \
      "https://github.com/hadolint/hadolint/releases/download/${HADOLINT_VERSION}/hadolint-linux-x86_64" \
 && echo "${HADOLINT_SHA256}  /usr/local/bin/hadolint" | sha256sum -c - \
 && chmod +x /usr/local/bin/hadolint \
 && hadolint --version

RUN npm install -g "markdownlint-cli@${MARKDOWNLINT_VERSION}" "@fission-ai/openspec@${OPENSPEC_VERSION}" \
 && pip install --break-system-packages --no-cache-dir "yamllint==${YAMLLINT_VERSION}" \
 && markdownlint --version && yamllint --version && openspec --version

# Builds should not send usage telemetry.
ENV OPENSPEC_TELEMETRY=0

WORKDIR /src
