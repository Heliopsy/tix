      "out": "| Step | Owner | Done |\n| :--- | :---: | ---: |\n| `make \\| tee` | @alice | **yes** |\n| INFRA-8 | @bob.smith | *no* |"
    },
    {
      "name": "table without outer pipes",
      "in": "a | b\n--|--\n1 | 2",
      "out": "| a | b |\n| --- | --- |\n| 1 | 2 |"
    },
    {
      "name": "table with raw HTML in a cell",
      "in": "| a |\n|---|\n| <b>x</b> |",
      "out": "| a |\n| --- |\n| <b>x</b> |"
    },
    {
      "name": "nested bullet and ordered lists",
      "in": "- one\n  - two\n    - three\n- four\n\n1. a\n2. b\n   1. c",
      "out": "- one\n  - two\n    - three\n- four\n\n1. a\n2. b\n   1. c"
    },
    {
      "name": "loose list with a second paragraph and a quote",
